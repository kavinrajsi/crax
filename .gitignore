# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# documentation — this repo is public. Notes about routes, authorization and
# known defects describe the attack surface, so they stay out of it entirely.
*.md

# sql — schema dumps, migrations, local backups and scratch queries. The
# database structure is not published either; no exceptions.
*.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
