# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# security assessments — these name the unprotected routes and the ungated
# actions. This repo is public; do not commit them.
ASSESSMENT.md
DATA-ROW-DRAWER.md

# sql — local dumps, backups and scratch queries stay out of the repo.
# The two exceptions below are load-bearing and must remain tracked:
#   db/schema.sql      — scripts/check-constraints.mjs and
#                        scripts/check-contact-fields.mjs read it whenever
#                        DATABASE_URL is unset, which is exactly how CI's
#                        secret-free `verify` job runs them.
#   db/migrations/*.sql — the record of what has actually been applied. If a
#                        new migration is ignored here, schema.sql drifts stale
#                        and the constraint guard passes against old truth.
*.sql
!db/schema.sql
!db/migrations/*.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
