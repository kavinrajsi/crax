# Copy to .env.local and fill in. Never commit .env.local.
# Names only — no real values belong in this file.

# ── Neon database ────────────────────────────────────────────────────────────
# Neon console → your project → Connection Details (pooled connection string).
DATABASE_URL=

# Direct (non-pooled) connection. Neon's scaffold sets this and some tooling
# expects it, but nothing in src/ reads it today.
DATABASE_URL_UNPOOLED=

# ── Neon Auth ────────────────────────────────────────────────────────────────
# Neon console → your project → Auth tab.
# The app fails at module load if these are missing (src/lib/auth.js).
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=

# Signs the cached session-data cookie. Must be at least 32 characters —
# @neondatabase/auth throws on a shorter one. Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# ── Daily follow-up digest ───────────────────────────────────────────────────
# Schedule is in vercel.json (08:00 UTC daily) and calls GET /api/digest.
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`; without this set the
# endpoint refuses scheduled calls. Generate: openssl rand -base64 32
CRON_SECRET=

# Where the digest is posted, as {"text": "..."} — a Slack or Discord incoming
# webhook, or Zapier/Make/n8n. Optional: if unset the digest is still computed
# and returned in the response, it just is not delivered anywhere.
DIGEST_WEBHOOK_URL=

# ── Public intake webhook ────────────────────────────────────────────────────
# Shared secret for POST /api/contacts/submit, sent as the x-webhook-secret
# header. WARNING: while this is unset the route accepts ANY unauthenticated
# POST and only logs a [SECURITY] line. Set it here and in Vercel, update the
# form that posts to it, then change the check in that route to fail closed.
WEBHOOK_SECRET=
