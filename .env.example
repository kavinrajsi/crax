# Copy to .env.local and fill in. Never commit .env.local.
# Names only — no real values belong in this file.

# ── Neon database ────────────────────────────────────────────────────────────
# Neon console → your project → Connection Details (pooled connection string).
DATABASE_URL=

# Direct (non-pooled) connection. Neon's scaffold sets this and some tooling
# expects it, but nothing in src/ reads it today.
DATABASE_URL_UNPOOLED=

# ── Neon Auth ────────────────────────────────────────────────────────────────
# Neon console → your project → Auth tab.
# The app fails at module load if these are missing (src/lib/auth.js).
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=

# Signs the cached session-data cookie. Must be at least 32 characters —
# @neondatabase/auth throws on a shorter one. Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# ── Super admins ─────────────────────────────────────────────────────────────
# Comma-separated addresses that may open /admin/users and the per-user logs.
# Compared lower-cased and trimmed, so casing and spacing do not matter.
# Fails CLOSED: unset or empty means nobody is an admin, and every /admin route
# answers 404 for everyone. Set it in Vercel too — a value here only affects
# local development.
SUPER_ADMIN_EMAILS=admin@example.com,second-admin@example.com

# ── Public intake webhook ────────────────────────────────────────────────────
# Shared secret for POST /api/contacts/submit, sent as the x-webhook-secret
# header. WARNING: while this is unset the route accepts ANY unauthenticated
# POST and only logs a [SECURITY] line. Set it here and in Vercel, update the
# form that posts to it, then change the check in that route to fail closed.
WEBHOOK_SECRET=

# ── Facebook Lead Ads webhook ────────────────────────────────────────────────
# Meta Developer Console → your app → Webhooks → Page → leadgen subscription.
# Requires the leads_retrieval permission, which needs App Review + Business
# Verification before it works against real (non-test) leads.
#
# Echoed back during Meta's GET verification handshake against
# GET /api/facebook/webhook. Pick any string; it just has to match on both sides.
FB_WEBHOOK_VERIFY_TOKEN=
# Verifies the X-Hub-Signature-256 header Meta sends on every webhook POST.
# App Dashboard → Settings → Basic → App Secret.
FB_APP_SECRET=
# Used to call the Graph API for each lead's field_data. Generate via a System
# User in Business Manager — a token tied to a personal login expires when
# that person's session does. Optional once at least one Page is connected via
# the "Connect Facebook" flow below — kept as a fallback for unconnected Pages.
#
# Covers the live webhook only. The historical backfill enumerates Pages from
# the facebook_page_connections table, and a Page carried by this env var has
# no row there — connect it through the OAuth flow to include it. See the
# backfill section at the end of this file.
FB_PAGE_ACCESS_TOKEN=

# ── LinkedIn Lead Gen Forms (Lead Sync API) ──────────────────────────────────
# developer.linkedin.com → your app → Auth tab. Requires approved Lead Sync
# API access (r_marketing_leadgen_automation) — a business-justification
# review that takes days to weeks; nothing works against real forms until
# it clears. The client secret triple-duties: OAuth token exchange, webhook
# challengeCode/X-LI-Signature verification, and OAuth-state signing.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Google Ads lead form webhook ─────────────────────────────────────────────
# Google Ads → lead form asset → Lead delivery → Webhook. Paste this same key
# there; Google echoes it back as `google_key` in every POST body and the
# route (POST /api/google/webhook) rejects anything else. Fail-closed: while
# unset, every delivery is rejected. Any string works — generate one:
# openssl rand -base64 24
GOOGLE_LEADS_WEBHOOK_KEY=

# ── Google Ads Reporting API (GAQL) ──────────────────────────────────────────
# Separate credentials from the lead-form webhook above, and they unlock two
# things: the /ads campaign chart (spend/clicks/conversions), and the historical
# lead backfill on that same page — the webhook key does NOT authorise the
# backfill, so an account with lead delivery working can still get
# "not configured" there. No official Node client exists (Google only ships
# Java/.NET/PHP/Python/Ruby/Perl), so src/lib/google-ads.js calls the REST
# :search endpoint directly.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web
# application). Enable the Google Ads API on the same project.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Google Ads account → Tools & Settings → API Center. New tokens start in
# test-account-only mode until Google approves basic/standard access —
# nothing works against real campaigns until then.
GOOGLE_ADS_DEVELOPER_TOKEN=
# One-time OAuth consent (scope: https://www.googleapis.com/auth/adwords)
# against the client id/secret above, run once to mint this — it does not
# expire on its own. Whoever runs the consent must have access to the Ads
# account below.
GOOGLE_ADS_REFRESH_TOKEN=
# The Ads account being queried, digits only (strip the dashes the UI shows).
GOOGLE_ADS_CUSTOMER_ID=
# Only set this if GOOGLE_ADS_CUSTOMER_ID is a child account under a manager
# (MCC) account — then this is the manager's id, digits only. A manager
# account has no campaigns of its own; querying it directly returns zero rows.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Facebook OAuth (Connect Facebook, Profile → Integrations) ────────────────
# App Dashboard → Settings → Basic → App ID. Public — used to build the
# authorize URL the browser is redirected to.
FB_APP_ID=
# Reuses FB_APP_SECRET above for the OAuth token exchange — same App, same
# secret, no separate value needed.

# ── Historical lead backfill ─────────────────────────────────────────────────
# Adds no variables of its own. Both backfills reuse credentials set above, but
# not the ones you would guess, so:
#
# Facebook (Profile → Integrations → "Import past Facebook leads")
#   Runs on the per-Page token stored by the Connect Facebook flow. It does NOT
#   use FB_PAGE_ACCESS_TOKEN — Pages carried by that env var have no
#   facebook_page_connections row, so nothing enumerates them; connect them
#   through OAuth to include them.
#   Needs pages_manage_ads in the OAuth scope, which the live webhook does not:
#   Meta hands the webhook a leadgen_id and leads_retrieval covers reading the
#   answers behind one, but listing a Page's forms is a separate permission.
#   A Page connected before that scope was added keeps its old token and 403s —
#   disconnect and reconnect it. The permission needs App Review, same as
#   leads_retrieval.
#   Recovers 90 days. Meta discards lead answers past that.
#
# Google (/ads → "Import past lead form submissions")
#   Runs on the GOOGLE_ADS_* Reporting credentials above, NOT
#   GOOGLE_LEADS_WEBHOOK_KEY. Lead delivery can be working perfectly while the
#   backfill reports "not configured" — they are unrelated credentials.
#   Recovers ~30 days. Google expires lead form submission data past that.
#
# Both are idempotent: a lead already in the CRM is skipped, so re-running
# after a failure or a partial run costs nothing but API calls.
